# 在本机 .env 中填写；已有 .env 时逐项合并，不要覆盖原文件。
# 使用独立的个人访问密码，至少 12 字符。不要使用 Binance 密码。
APP_PASSWORD=
APP_ORIGIN=http://127.0.0.1:3000
APP_MODE=real

# 可选：复盘账本目录，默认 .local/review；切换目录不会自动搬迁已有归档。
# REVIEW_DATA_DIR=.local/review

# 仅支持 HMAC API Key。专用只读权限；禁止交易、提现和划转权限。
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 可选：只在用户主动发起单笔或批量复盘时调用模型；密钥仅留在后端。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-pro
LLM_EFFORT=high
LLM_API_KEY=

# 可选：沿用本机 HTTP_PROXY / HTTPS_PROXY / NO_PROXY。
# HTTPS_PROXY=http://127.0.0.1:代理端口
# 手机访问时，将 APP_ORIGIN 改为电脑的本地 HTTPS 地址并配置证书。
# TLS_CERT_FILE=.local/cert.pem
# TLS_KEY_FILE=.local/key.pem
