{
  "name": "entry-guidance",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "start": "node --use-env-proxy --env-file-if-exists=.env src/main.ts",
    "dev": "node --use-env-proxy --env-file-if-exists=.env src/main.ts --dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.frontend.json",
    "test": "node --test test/*.test.ts",
    "test:browser": "playwright test",
    "lint": "eslint frontend vite.config.ts playwright.config.ts test/browser",
    "format": "prettier --write frontend vite.config.ts playwright.config.ts test/browser eslint.config.js",
    "format:check": "prettier --check frontend vite.config.ts playwright.config.ts test/browser eslint.config.js",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test && pnpm test:browser"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "vue": "^3.5.43"
  }
}
